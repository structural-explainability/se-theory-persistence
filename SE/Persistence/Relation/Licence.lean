module

public import SE.Persistence.Relation.Survival
public import SE.Persistence.Relation.Equivalence
public import SE.Persistence.Commitment.Compare

set_option autoImplicit false

/-!
# Licence

SE.Persistence.Relation.Licence

A licence says which individual steps count as continuations of the same
individual. A classification decides this by operator: if an operator preserves,
every step of that operator is a continuation. A licence decides it for each
step, so the same operator can continue identity in one case and not in another.

- `Licence.stepRel` and `Licence.identityRel` are the steps a licence licenses
  and the equivalence relation they generate.
- Every classification gives a licence that depends only on the operator
  (`Classification.toLicence`).
- Conversely, on a given dynamics a licence comes from a classification exactly
  when it is operator-level there (`operatorLevelOn_iff_exists_classification`).
- `no_classification_realizes_firstOnly` is a concrete case where no
  classification gives the licensed identity.

A licence sees the operator and the two states. If licensing depends on earlier
history, the history must be part of the state.

This is the formal content of the observation that a transformation name and a
sortal do not determine whether identity continues. What licenses a step is a
question for the kind of individual concerned; this module says only that the
information cannot be carried by the operator alone.
-/

namespace SE.Persistence

@[expose] public section

variable {T C : Type}

-- RR.DEFINES: PS.TYPE.LICENCE
/--
A licence over operators `T` and states `C`: `licensed t x y` says that the
step of `t` from `x` to `y`, if it occurs, counts as a continuation.
-/
structure Licence (T C : Type) where
  /-- `licensed t x y`: the step of `t` from `x` to `y` is a continuation. -/
  licensed : T → C → C → Prop

-- RR.DEFINES: PS.DEF.LICENCE_STEP_REL
/-- The steps of the dynamics that the licence licenses. -/
def Licence.stepRel (L : Licence T C) (d : Dynamics T C) : C → C → Prop :=
  fun x y => ∃ t, d.step t x y ∧ L.licensed t x y

-- RR.DEFINES: PS.DEF.LICENCE_IDENTITY_REL
/-- The identity relation generated by the licensed steps. -/
def Licence.identityRel (L : Licence T C) (d : Dynamics T C) : C → C → Prop :=
  Generated (L.stepRel d)

/-- The identity relation of a licence is an equivalence relation. -/
theorem Licence.identityRel_equivalence (L : Licence T C) (d : Dynamics T C) :
    Equivalence (L.identityRel d) :=
  Generated.equivalence _

-- RR.DEFINES: PS.DEF.CLASSIFICATION_TO_LICENCE
/-- The licence that licenses every step of every preserving operator. -/
def Classification.toLicence (c : Classification T) (C : Type) : Licence T C where
  licensed t _ _ := c.IsPrs t

-- RR.DEFINES: PS.THM.TO_LICENCE_STEP_REL
/-- A classification and its licence license the same steps. -/
theorem Classification.toLicence_stepRel (c : Classification T)
    (d : Dynamics T C) : (c.toLicence C).stepRel d = c.stepRel d := by
  funext x y
  apply propext
  constructor
  · rintro ⟨t, hs, hp⟩
    exact ⟨t, hp, hs⟩
  · rintro ⟨t, hp, hs⟩
    exact ⟨t, hs, hp⟩

-- RR.DEFINES: PS.THM.TO_LICENCE_IDENTITY_REL
/-- A classification and its licence generate the same identity relation. -/
theorem Classification.toLicence_identityRel (c : Classification T)
    (d : Dynamics T C) : (c.toLicence C).identityRel d = c.identityRel d := by
  unfold Licence.identityRel Classification.identityRel
  rw [Classification.toLicence_stepRel]

-- RR.DEFINES: PS.DEF.OPERATOR_LEVEL_ON
/--
A licence is operator-level on a dynamics when any two steps of the same
operator are either both licensed or both not.
-/
def Licence.OperatorLevelOn (L : Licence T C) (d : Dynamics T C) : Prop :=
  ∀ t x y x' y', d.step t x y → d.step t x' y' →
    (L.licensed t x y ↔ L.licensed t x' y')

/-- The licence of a classification is operator-level. -/
theorem Classification.toLicence_operatorLevelOn (c : Classification T)
    (d : Dynamics T C) : (c.toLicence C).OperatorLevelOn d :=
  fun _ _ _ _ _ _ _ => Iff.rfl

-- RR.DEFINES: PS.THM.OPERATOR_LEVEL_ON_IFF_EXISTS_CLASSIFICATION
/--
On a given dynamics, a licence agrees with some classification on every step
exactly when it is operator-level there.
-/
theorem operatorLevelOn_iff_exists_classification (L : Licence T C)
    (d : Dynamics T C) :
    L.OperatorLevelOn d ↔
      ∃ c : Classification T, ∀ t x y, d.step t x y →
        (L.licensed t x y ↔ c.IsPrs t) := by
  constructor
  · intro h
    classical
    let c : Classification T :=
      { pattern := fun t =>
          if ∃ x y, d.step t x y ∧ L.licensed t x y
          then some ClassificationValue.prs
          else some ClassificationValue.ign
        persist := fun _ => False }
    have hc : ∀ t, c.IsPrs t ↔ ∃ x y, d.step t x y ∧ L.licensed t x y := by
      intro t
      unfold Classification.IsPrs
      by_cases hex : ∃ x y, d.step t x y ∧ L.licensed t x y <;> simp [c, hex]
    refine ⟨c, fun t x y hs => ?_⟩
    rw [hc t]
    constructor
    · intro hl
      exact ⟨x, y, hs, hl⟩
    · rintro ⟨x', y', hs', hl'⟩
      exact (h t x' y' x y hs' hs).1 hl'
  · rintro ⟨c, hc⟩ t x y x' y' hs hs'
    rw [hc t x y hs, hc t x' y' hs']

-- RR.DEFINES: PS.THM.EXISTS_LICENSED_STEP_WITNESS
/--
If the steps licensed by `L₁` do not all lie inside the identity generated by
`L₂`, one specific licensed step of `L₁` accounts for the difference.
-/
theorem Licence.exists_licensed_step_witness (L₁ L₂ : Licence T C)
    (d : Dynamics T C) (h : ¬ GeneratedLE (L₁.stepRel d) (L₂.stepRel d)) :
    ∃ t x y, d.step t x y ∧ L₁.licensed t x y ∧ ¬ L₂.identityRel d x y := by
  obtain ⟨x, y, ⟨t, hs, hl⟩, hn⟩ := exists_generator_witness h
  exact ⟨t, x, y, hs, hl, hn⟩

/-! ### An identity that no classification gives

One operator, four states, and two steps of that operator, `0 → 1` and
`2 → 3`. The licence that licenses only the first step relates `0` and `1` but
not `2` and `3`. A classification must treat the two steps alike, so it relates
both pairs or neither. -/

-- RR.DEFINES: PS.DEF.TWO_STEPS
/-- One operator with two steps: `0 → 1` and `2 → 3`. -/
def twoSteps : Dynamics Unit (Fin 4) where
  step _ x y := (x = 0 ∧ y = 1) ∨ (x = 2 ∧ y = 3)

-- RR.DEFINES: PS.DEF.FIRST_ONLY
/-- The licence that licenses only steps that start at `0`. -/
def firstOnly : Licence Unit (Fin 4) where
  licensed _ x _ := x = 0

/-- The licence `firstOnly` relates `0` and `1`. -/
theorem firstOnly_identityRel_zero_one :
    firstOnly.identityRel twoSteps 0 1 :=
  Generated.rel ⟨(), Or.inl ⟨rfl, rfl⟩, rfl⟩

/-- The licence `firstOnly` does not relate `2` and `3`. -/
theorem firstOnly_not_identityRel_two_three :
    ¬ firstOnly.identityRel twoSteps 2 3 := by
  intro h
  have key := Generated.le_of_equivalence
    (s := fun a b : Fin 4 => (if a.val ≤ 1 then 0 else a.val) =
      (if b.val ≤ 1 then 0 else b.val))
    ⟨fun _ => rfl, fun h => h.symm, fun h1 h2 => h1.trans h2⟩ ?_ h
  · revert key
    decide
  · rintro x y ⟨_, hs, hl⟩
    rcases hs with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · decide
    · have h20 : (2 : Fin 4) = 0 := hl
      exact absurd h20 (by decide)

-- RR.DEFINES: PS.THM.NO_CLASSIFICATION_REALIZES_FIRST_ONLY
/--
No classification of the single operator relates `0` and `1` but not `2` and
`3` on `twoSteps`. The identity of `firstOnly` is not the identity of any
classification.
-/
theorem no_classification_realizes_firstOnly :
    ¬ ∃ c : Classification Unit,
      c.identityRel twoSteps 0 1 ∧ ¬ c.identityRel twoSteps 2 3 := by
  rintro ⟨c, h01, h23⟩
  by_cases hp : c.IsPrs ()
  · exact h23 (Generated.rel ⟨(), hp, Or.inr ⟨rfl, rfl⟩⟩)
  · have key := Generated.le_of_equivalence
      (s := fun a b : Fin 4 => a = b)
      ⟨fun _ => rfl, fun h => h.symm, fun h1 h2 => h1.trans h2⟩ ?_ h01
    · revert key
      decide
    · rintro x y ⟨t, ht, _⟩
      exact absurd ht hp

/-- `firstOnly` is not operator-level on `twoSteps`. -/
theorem firstOnly_not_operatorLevelOn : ¬ firstOnly.OperatorLevelOn twoSteps := by
  intro h
  have h23 := (h () 0 1 2 3 (Or.inl ⟨rfl, rfl⟩) (Or.inr ⟨rfl, rfl⟩)).1 rfl
  have h20 : (2 : Fin 4) = 0 := h23
  exact absurd h20 (by decide)

end

end SE.Persistence
