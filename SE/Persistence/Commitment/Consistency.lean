module

public import SE.Persistence.Relation.Generated

set_option autoImplicit false

/-!
# Commitment Consistency

SE.Persistence.Commitment.Consistency

Identity judgments as constraints. A body of judgments has two parts:

- `P`: pairs asserted to be the same individual;
- `D`: pairs asserted to be distinct individuals.

An identity relation is admissible for `(P, D)` when it is an equivalence
relation that contains every pair of `P` and no pair of `D`.

The main fact is that an admissible relation exists exactly when the
equivalence relation generated by `P` contains no pair of `D`. The generated
relation is the least equivalence containing `P`, so it is the only candidate
that needs checking.

This module does not say where `P` or `D` come from. They are inputs, and a
wrong input gives a wrong consequence. In particular, the identity relation of
a classification is `Generated` of its preserving steps, so it is the
`P`-closure for `P` equal to those steps.
-/

namespace SE.Persistence

@[expose] public section

variable {C : Type}

-- RR.DEFINES: PS.DEF.ADMISSIBLE
/--
`E` is an admissible identity relation for same-commitments `P` and
distinct-commitments `D`: an equivalence relation containing `P` and no pair
of `D`.
-/
def Admissible (P D E : C → C → Prop) : Prop :=
  Equivalence E ∧ (∀ x y, P x y → E x y) ∧ (∀ x y, D x y → ¬ E x y)

-- RR.DEFINES: PS.DEF.CONSISTENT
/--
`P` and `D` are consistent: no pair asserted distinct is in the equivalence
relation generated by `P`.

`Generated P` is symmetric, so this also controls `D y x` whenever `D x y`.
-/
def Consistent (P D : C → C → Prop) : Prop :=
  ∀ x y, D x y → ¬ Generated P x y

-- RR.DEFINES: PS.THM.ADMISSIBLE_GENERATED_OF_CONSISTENT
/-- When the commitments are consistent, the generated relation is admissible. -/
theorem admissible_generated_of_consistent {P D : C → C → Prop}
    (h : Consistent P D) : Admissible P D (Generated P) :=
  ⟨Generated.equivalence P, fun _ _ hxy => Generated.rel hxy, h⟩

-- RR.DEFINES: PS.THM.CONSISTENT_OF_ADMISSIBLE
/-- An admissible relation makes the commitments consistent. -/
theorem consistent_of_admissible {P D E : C → C → Prop}
    (h : Admissible P D E) : Consistent P D := by
  intro x y hD hg
  exact h.2.2 x y hD (Generated.le_of_equivalence h.1 h.2.1 hg)

-- RR.DEFINES: PS.THM.CONSISTENT_IFF_EXISTS_ADMISSIBLE
/--
Consistency is exactly the existence of an admissible identity relation.
-/
theorem consistent_iff_exists_admissible {P D : C → C → Prop} :
    Consistent P D ↔ ∃ E, Admissible P D E :=
  ⟨fun h => ⟨Generated P, admissible_generated_of_consistent h⟩,
    fun ⟨_, h⟩ => consistent_of_admissible h⟩

/-- Consistency is monotone downward: fewer commitments stay consistent. -/
theorem Consistent.mono {P P' D D' : C → C → Prop} (h : Consistent P' D')
    (hP : ∀ x y, P x y → P' x y) (hD : ∀ x y, D x y → D' x y) :
    Consistent P D :=
  fun x y hd hg => h x y (hD x y hd) (Generated.mono hP hg)

-- RR.DEFINES: PS.THM.CONSISTENT_UNION_IFF
/--
Distinctness from two independent sources is consistent with `P` exactly when
each source is. Several observers can be checked one at a time.
-/
theorem consistent_union_iff {P D₁ D₂ : C → C → Prop} :
    Consistent P (fun x y => D₁ x y ∨ D₂ x y) ↔
      Consistent P D₁ ∧ Consistent P D₂ := by
  constructor
  · intro h
    exact ⟨fun x y hd => h x y (Or.inl hd), fun x y hd => h x y (Or.inr hd)⟩
  · rintro ⟨h1, h2⟩ x y hd
    rcases hd with hd | hd
    · exact h1 x y hd
    · exact h2 x y hd

/-! ### Witnesses

A generated identity has a finite explanation: a chain of asserted pairs, each
used in either direction. -/

-- RR.DEFINES: PS.DEF.SYMM_STEP
/-- One asserted pair of `r`, used in either direction. -/
def SymmStep (r : C → C → Prop) : C → C → Prop :=
  fun x y => r x y ∨ r y x

/-- Reach along a symmetric step relation can be reversed. -/
theorem Reach.symm_of_symmetric {s : C → C → Prop}
    (hs : ∀ x y, s x y → s y x) {x y : C} (h : Reach s x y) : Reach s y x := by
  induction h with
  | refl => exact Reach.refl
  | tail _ hr ih => exact Reach.trans (Reach.single (hs _ _ hr)) ih

/-- A chain of asserted pairs gives a generated identity. -/
theorem Generated.of_reach_symmStep {r : C → C → Prop} {x y : C}
    (h : Reach (SymmStep r) x y) : Generated r x y := by
  induction h with
  | refl => exact Generated.refl x
  | tail _ hr ih =>
    rcases hr with hr | hr
    · exact Generated.trans ih (Generated.rel hr)
    · exact Generated.trans ih (Generated.symm (Generated.rel hr))

/-- A generated identity gives a chain of asserted pairs. -/
theorem Generated.to_reach_symmStep {r : C → C → Prop} {x y : C}
    (h : Generated r x y) : Reach (SymmStep r) x y := by
  induction h with
  | rel hxy => exact Reach.single (Or.inl hxy)
  | refl x => exact Reach.refl
  | symm _ ih =>
    exact Reach.symm_of_symmetric (fun _ _ hs => hs.symm) ih
  | trans _ _ ih1 ih2 => exact Reach.trans ih1 ih2

-- RR.DEFINES: PS.THM.GENERATED_IFF_REACH_SYMM_STEP
/--
`x` and `y` are generated-identical exactly when a finite chain of asserted
pairs, each used in either direction, connects them. The chain is the
explanation for the identity.
-/
theorem generated_iff_reach_symmStep {r : C → C → Prop} {x y : C} :
    Generated r x y ↔ Reach (SymmStep r) x y :=
  ⟨Generated.to_reach_symmStep, Generated.of_reach_symmStep⟩

end

end SE.Persistence
