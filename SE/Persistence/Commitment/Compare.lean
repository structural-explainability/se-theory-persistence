module

public import SE.Persistence.Relation.Generated

set_option autoImplicit false

/-!
# Comparing Commitment Sets

SE.Persistence.Commitment.Compare

Two bodies of same-commitments `P` and `Q` generate two identity relations. This
module says when one is contained in the other and, when they differ, that the
difference is always pinned to a single commitment.

- Containment is checked on generators: `Generated P` is contained in
  `Generated Q` exactly when every pair of `P` is generated by `Q`.
- If it is not contained, some single pair of `P` is not generated by `Q`.

So a disagreement between two rules about who is the same as whom is never
diffuse. Some specific asserted pair on one side accounts for it.
-/

namespace SE.Persistence

@[expose] public section

variable {C : Type}

-- RR.DEFINES: PS.DEF.GENERATED_LE
/-- The identity generated by `P` is contained in the identity generated by `Q`. -/
def GeneratedLE (P Q : C → C → Prop) : Prop :=
  ∀ x y, Generated P x y → Generated Q x y

-- RR.DEFINES: PS.THM.GENERATED_LE_IFF
/-- Containment of generated identities is checked on generators. -/
theorem generatedLE_iff {P Q : C → C → Prop} :
    GeneratedLE P Q ↔ ∀ x y, P x y → Generated Q x y := by
  constructor
  · intro h x y hp
    exact h x y (Generated.rel hp)
  · intro h x y hg
    exact Generated.le_of_equivalence (Generated.equivalence Q) h hg

/-- Containment is reflexive. -/
theorem GeneratedLE.refl (P : C → C → Prop) : GeneratedLE P P :=
  fun _ _ h => h

/-- Containment is transitive. -/
theorem GeneratedLE.trans {P Q R : C → C → Prop} (h1 : GeneratedLE P Q)
    (h2 : GeneratedLE Q R) : GeneratedLE P R :=
  fun x y h => h2 x y (h1 x y h)

-- RR.DEFINES: PS.THM.EXISTS_GENERATOR_WITNESS
/--
If the identity generated by `P` is not contained in the one generated by `Q`,
a single asserted pair of `P` is the cause: `Q` does not generate it.
-/
theorem exists_generator_witness {P Q : C → C → Prop} (h : ¬ GeneratedLE P Q) :
    ∃ x y, P x y ∧ ¬ Generated Q x y := by
  refine Classical.byContradiction fun hno => h ?_
  apply generatedLE_iff.2
  intro x y hp
  refine Classical.byContradiction fun hq => hno ⟨x, y, hp, hq⟩

-- RR.DEFINES: PS.THM.EXISTS_GENERATOR_DIFFERENCE
/--
If `P` and `Q` generate different identity relations, a single asserted pair
on one side accounts for the difference.
-/
theorem exists_generator_difference {P Q : C → C → Prop}
    (h : ¬ (GeneratedLE P Q ∧ GeneratedLE Q P)) :
    ∃ x y, (P x y ∧ ¬ Generated Q x y) ∨ (Q x y ∧ ¬ Generated P x y) := by
  refine Classical.byContradiction fun hno => h ⟨?_, ?_⟩
  · refine Classical.byContradiction fun hl => ?_
    obtain ⟨x, y, hp, hq⟩ := exists_generator_witness hl
    exact hno ⟨x, y, Or.inl ⟨hp, hq⟩⟩
  · refine Classical.byContradiction fun hl => ?_
    obtain ⟨x, y, hp, hq⟩ := exists_generator_witness hl
    exact hno ⟨x, y, Or.inr ⟨hp, hq⟩⟩

end

end SE.Persistence
